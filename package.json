{
  "name": "dsh-workbuddy-bridge",
  "version": "0.1.0",
  "description": "DSH plugin that attaches to a local WorkBuddy2API gateway, exposes 19 Tencent CodeBuddy / WorkBuddy models, and surfaces balance / cooldown / OAuth through the DSH Models page and the dsh-cost-meter gateway quota panel.",
  "type": "module",
  "main": "lib/host/index.js",
  "exports": {
    ".": {
      "types": "./lib/host/index.d.ts",
      "default": "./lib/host/index.js"
    },
    "./client": "./lib/client/client.js",
    "./shared/*": "./lib/shared/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "locale",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    },
    "compatibility": {
      "dsh": ">=0.2.1-alpha.2 <0.3.0-0",
      "node": ">=20"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:client": "node scripts/copy-client.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1-rc.1 <5.0.0-0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.2",
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mojingjing-git/dsh-workbuddy-bridge.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "workbuddy",
    "codebuddy",
    "llm",
    "tencent"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
